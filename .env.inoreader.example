# Inoreader connector credentials -- copy to `.env.inoreader` and fill in.
# `.env.inoreader` is gitignored; this template is not. Never put real values here.
#
#   cp .env.inoreader.example .env.inoreader
#
# 1. Register an application: https://www.inoreader.com/developers/register-app
#    That gives you the App ID and App Key below. For most registrations the OAuth
#    client id/secret are the SAME two values -- fill them in twice unless Inoreader
#    handed you a separate pair.
# 2. Mint a refresh token once:  python tools/oauth_bootstrap.py
#    (it reads APP_ID/APP_KEY/REDIRECT_URI from this file and prints the rest)
# 3. Validate everything:        python tools/live_check.py
#
# The refresh token is long-lived and account-scoped. It survives lab rebuilds --
# unlike the Miniflux token it replaces, which died with its container.

INOREADER_APP_ID=
INOREADER_APP_KEY=

# Usually identical to APP_ID / APP_KEY above.
INOREADER_CLIENT_ID=
INOREADER_CLIENT_SECRET=

# Must exactly match the redirect URI registered with the application. Inoreader
# never has to reach it -- you copy the `code` out of the redirected URL by hand --
# so a localhost URL you registered is fine.
INOREADER_REDIRECT_URI=http://localhost:8080/callback

# Filled in by tools/oauth_bootstrap.py. This is the only long-lived secret here.
INOREADER_REFRESH_TOKEN=

# Optional. The stream the live checks read. Defaults to the whole reading list;
# point it at the demo folder to exercise what UC-12 actually uses.
#INOREADER_STREAM_ID=user/-/label/Patch Intel
